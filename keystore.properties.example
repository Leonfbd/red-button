# Szablon konfiguracji podpisu wydania (Release Signing) dla Red Button (pl.leon.redbutton).
# Skopiuj ten plik jako `keystore.properties` (plik jest ignorowany przez Git)
# lub ustaw zmienne środowiskowe:
#   RED_BUTTON_KEYSTORE_PATH
#   RED_BUTTON_KEYSTORE_PASSWORD
#   RED_BUTTON_KEY_ALIAS
#   RED_BUTTON_KEY_PASSWORD
#
# UWAGA (Sekcja 11 specyfikacji): przed publikacją produkcyjną zaplanuj bezpieczne
# przechowywanie klucza oraz jego kopię zapasową poza repozytorium.

storeFile=/sciezka/do/red-button-release.jks
storePassword=ZMIEN_HASLO_KEYSTORE
keyAlias=redbutton
keyPassword=ZMIEN_HASLO_KLUCZA
